# DHRUVA - backend environment configuration
# Copy to server/.env
#
# DHRUVA runs out of the box with a file-based SQLite database (zero config).
# Set DATABASE_URL to a PostgreSQL URL to use PostgreSQL instead, e.g.
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dhruva
# (pip install psycopg2-binary when using PostgreSQL.)

DATABASE_URL=sqlite:///./data/dhruva.db

# JWT signing secret. If not set, a persistent random secret is created at
# first startup under server/data/.jwt_secret so sessions survive restarts.
JWT_SECRET=

# Token lifetime in minutes
JWT_EXPIRES_MINUTES=720

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional external services ------------------------------------------
# These are OPTIONAL. When not configured, DHRUVA clearly shows
# "not configured" states instead of pretending the service is live.
#
# OpenWeatherMap API key (weather live data when available)
# OWM_API_KEY=
# OWM_BASE_URL=https://api.openweathermap.org/data/2.5

# Gemini API key (optional LLM backend for the AI assistant / emergency AI.
# When unset, the built-in retrieval + rule engine is used.)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# SMTP for email notifications (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# SMS provider webhook (optional, e.g. any HTTP endpoint that accepts JSON)
# SMS_WEBHOOK_URL=

# --- Demo / seed ----------------------------------------------------------
# Set 0 to skip seeding demo data on an empty database.
SEED_DEMO=true